{
  "manifest_version": 3,
  "name": "Vantage Futbin Scanner",
  "version": "1.6.0",
  "description": "Futbin Diff-Scanner f\u00fcr Special Cards.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.googleusercontent.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://www.futbin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vantage Futbin Scanner"
  }
}
